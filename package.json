{
  "name": "data-driven-curriculum",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:demo": "node --import tsx scripts/generate-demo-data.ts",
    "build:webpack": "next build --webpack",
    "test:e2e": "node e2e/smoke.mjs && node e2e/analytics-suite.mjs",
    "pdf:preview": "node --import tsx scripts/generate-report-preview.ts",
    "test:pdf": "vitest run tests/pdf.test.ts",
    "verify:pdf": "python3 scripts/verify-report-pdf.py"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "^9.3.14",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "pdf-lib": "1.17.1",
    "@pdf-lib/fontkit": "1.1.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.63.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
