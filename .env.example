# AI-объяснения BilimLens. Скопируйте в .env.local и укажите ключи.
# Ключи читаются только на сервере (Route Handler /api/ai); не используйте префикс NEXT_PUBLIC_.
# Без ключей аналитика работает полностью, AI-блоки показывают «AI не настроен».

GEMINI_API_KEY=
GROQ_API_KEY=

# Модели: список через запятую — следующая пробуется при таймауте или перегрузке.
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash
GROQ_MODEL=openai/gpt-oss-120b

# gemini | groq — основной провайдер; второй используется только при временных ошибках.
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_ENABLED=true
# false — полностью выключить AI.
AI_ENABLED=true

# По умолчанию AI доступен только для синтетических демо-данных.
# true — разрешить обезличенные агрегаты загруженных данных школы (группы < 10 учеников не передаются).
AI_ALLOW_UPLOADED_DATA=false

# Защита от злоупотреблений и расходов.
AI_REQUESTS_PER_MINUTE=6
AI_DAILY_ATTEMPT_LIMIT=200
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=2400
# Дополнительные разрешённые Origin через запятую (например, адрес за прокси).
AI_ALLOWED_ORIGINS=
